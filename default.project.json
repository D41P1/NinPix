{
  "name": "NinPix",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/ReplicatedStorage"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/ServerScriptService"
      }
    },
    
    "StarterPlayer": {
      "StarterPlayerScripts": {
      }
    },
    "ReplicatedFirst" : {
      "RepFirstFolder": {
        "$path": "src/ReplicatedFirst"
      }
    },
    "Workspace": {
      "WorkSpaceFolder": {
        "$path" : "src/WorkSpace"
      },
      "$properties": {
        "FilteringEnabled": true
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}